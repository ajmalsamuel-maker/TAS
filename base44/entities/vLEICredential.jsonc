{
  "name": "vLEICredential",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Which organization issued this vLEI"
    },
    "vlei_id": {
      "type": "string",
      "description": "Unique vLEI identifier"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "OOR",
        "ECR"
      ],
      "description": "Official Organizational Role or Engagement Context Role"
    },
    "holder_name": {
      "type": "string",
      "description": "Name of the vLEI credential holder"
    },
    "holder_email": {
      "type": "string",
      "description": "Email of the credential holder"
    },
    "holder_did": {
      "type": "string",
      "description": "DID of the credential holder (optional)"
    },
    "role_title": {
      "type": "string",
      "description": "Job title or role (e.g., CEO, CFO, Project Manager)"
    },
    "authority_scope": {
      "type": "string",
      "description": "What authority this credential grants"
    },
    "issued_by": {
      "type": "string",
      "description": "Email of the user who issued this credential"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "default": "active",
      "description": "Current status of the credential"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "description": "Credential validity start date"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "Credential expiry date (null = no expiry)"
    },
    "credential_data": {
      "type": "object",
      "description": "Full W3C Verifiable Credential JSON"
    },
    "revocation_reason": {
      "type": "string",
      "description": "Reason for revocation if revoked"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the credential was revoked"
    }
  },
  "required": [
    "organization_id",
    "vlei_id",
    "credential_type",
    "holder_name",
    "holder_email",
    "role_title"
  ]
}