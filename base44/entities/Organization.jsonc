{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization name (e.g., 'ABC Bank', 'XYZ Fintech')"
    },
    "legal_name": {
      "type": "string",
      "description": "Legal entity name"
    },
    "organization_type": {
      "type": "string",
      "enum": [
        "bank",
        "fintech",
        "credit_union",
        "law_firm",
        "insurance",
        "other"
      ],
      "description": "Type of organization using the platform"
    },
    "lei": {
      "type": "string",
      "description": "Organization's own LEI"
    },
    "country": {
      "type": "string",
      "description": "Primary operating country"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "starter",
        "business",
        "enterprise"
      ],
      "default": "starter",
      "description": "Subscription tier"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "trial",
      "description": "Subscription status"
    },
    "monthly_fee": {
      "type": "number",
      "description": "Monthly subscription fee in USD"
    },
    "api_calls_limit": {
      "type": "number",
      "description": "Monthly API call limit"
    },
    "api_calls_used": {
      "type": "number",
      "default": 0,
      "description": "API calls used this month"
    },
    "tmaas_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Transaction Monitoring as a Service feature enabled"
    },
    "tmaas_pricing_model": {
      "type": "string",
      "enum": [
        "per_transaction",
        "flat_monthly",
        "tiered"
      ],
      "description": "TMaaS pricing model"
    },
    "tmaas_transaction_limit": {
      "type": "number",
      "description": "Monthly transaction monitoring limit"
    },
    "tmaas_transactions_used": {
      "type": "number",
      "default": 0,
      "description": "Transactions monitored this month"
    },
    "settings": {
      "type": "object",
      "description": "Organization-specific settings",
      "properties": {
        "branding_logo_url": {
          "type": "string"
        },
        "primary_color": {
          "type": "string"
        },
        "default_language": {
          "type": "string",
          "default": "en"
        },
        "webhook_url": {
          "type": "string"
        },
        "enable_auto_approval": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Primary contact phone"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether organization is active"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether initial setup is complete"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trial expiration date"
    }
  },
  "required": [
    "name",
    "organization_type"
  ]
}